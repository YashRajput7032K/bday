══ */\n68: #slide3{background:linear-gradient(135deg,#fff0f5,#ffecd2)}\n69: #game-area{position:relative;width:100%;max-width:500px;height:60vh;max-height:500px;background:rgba(255,255,255,.4);border-radius:1.2rem;border:2px dashed var(--pink);overflow:hidden;touch-action:none;cursor:crosshair}\n70: .game-balloon{position:absolute;border-radius:50% 50% 50% 50%/60% 60% 40% 40%;cursor:pointer;transition:transform .1s;user-select:none;display:flex;align-items:center;justify-content:center;font-size:1.2rem}\n71: .game-balloon:hover{transform:scale(1.1)}\n72: .pop{animation:pop .3s ease-out forwards}\n73: #score-bar{display:flex;align-items:center;justify-content:space-between;width:100%;max-width:500px;margin-bottom:1rem}\n74: #score-bar h2{font-family:'Dancing Script',cursive;font-size:1.6rem;color:var(--deep)}\n75: #score{font-size:1.3rem;font-weight:600;color:var(--gold)}\n76: #play-again{margin-top:1.2rem;background:linear-gradient(135deg,var(--pink),#e895b3);color:#fff}\n77: \n78: /* Game end screen */\n79: #game-end{display:none;flex-direction:column;align-items:center;justify-content:center;text-align:center;width:100%;max-width:500px;padding:2rem;animation:fadeIn .6s}\n80: #game-end h2{font-family:'Dancing Script',cursive;font-size:clamp(1.8rem,5vw,2.6rem);color:var(--deep);margin-bottom:.5rem}\n81: #game-end .end-emoji{font-size:clamp(3rem,10vw,5rem);margin-bottom:1rem}\n82: #game-end .end-msg{font-size:clamp(1rem,3vw,1.2rem);color:var(--soft-text);margin-bottom:.3rem}\n83: #game-end .final-score{font-size:clamp(1.3rem,4vw,1.8rem);font-weight:700;color:var(--gold);margin-bottom:1.5rem}\n84: \n85: /* ── Keyframes ── */\n86: @keyframes fadeDown{from{opacity:0;transform:translateY(-20px)}to{opacity:1;transform:translateY(0)}}\n87: @keyframes fadeIn{from{opacity:0}to{opacity:1}}\n88: @keyframes bounce{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}\n89: @keyframes floatUp{0%{transform:translateY(0) rotate(0);opacity:.9}100%{transform:translateY(-110vh) rotate(15deg);opacity:0}}\n90: @keyframes pop{0%{transform:scale(1);opacity:1}50%{transform:scale(1.4);opacity:.5}100%{transform:scale(0);opacity:0}}\n91: @keyframes spin{to{transform:rotate(360deg)}}\n92: </style>\n93: </head>\n94: <body>\n95: \n96: <!-- Sparkle overlay -->\n97: <canvas id=\"sparkle-canvas\"></canvas>\n98: \n99: <!-- Music -->\n100: <button id=\"music-ctrl\" onclick=\"toggleMusic()\" aria-label=\"Play birthday music\">🎵 <span id=\"music-label\">Play music</span></button>\n101: <div id=\"music-note\">Birthday song: <strong>pal.mp3</strong></div>\n102: <audio id=\"bgm\" loop preload=\"auto\" autoplay><source src=\"pal.mp3\" type=\"audio/mpeg\"></audio>\n103: \n104: <!-- Balloon celebration overlay -->\n105: <div id=\"balloons\"></div>\n106: \n107: <!-- ═══════ SLIDE 1 ═══════ -->\n108: <section class=\"slide active\" id=\"slide1\">\n109:   <div class=\"deco\" style=\"top:8%;left:5%\">🎈</div>\n110:   <div class=\"deco\" style=\"top:12%;right:8%\">🎉</div>\n111:   <div class=\"deco\" style=\"bottom:15%;left:10%\">🎀</div>\n112:   <div class=\"deco\" style=\"bottom:10%;right:6%\">✨</div>\n113:   <div class=\"deco\" style=\"top:40%;left:2%\">🌸</div>\n114:   <div class=\"deco\" style=\"top:35%;right:3%\">🎂</div>\n115: \n116:   <div class=\"cake\">🎂</div>\n117:   <h1>Happy Birthday, Khushbu Didi!</h1>\n118:   <p class=\"subtitle\">A little celebration for someone who makes life brighter ✨</p>\n119: \n120:   <div id=\"q-section\">\n121:     <p class=\"question\">Do you love your brother? 💕</p>\n122:     <div class=\"btn-row\" id=\"btn-row\">\n123:       <button class=\"btn\" id=\"yes-btn\" onclick=\"sayYes()\">YES — YASH 💖</button>\n124:       <button class=\"btn\" id=\"no-btn\" onclick=\"runAway()\">NO 😶</button>\n125:     </div>\n126:   </div>\n127: \n128:   <div id=\"result\">\n129:     <h2>Yay! You're the best sister! 🥰🎉</h2>\n130:     <button class=\"btn\" id=\"continue1\" onclick=\"goSlide(2)\">Read My Letter →</button>\n131:   </div>\n132: </section>\n133: \n134: <!-- ═══════ SLIDE 2 ═══════ -->\n135: <section class=\"slide\" id=\"slide2\">\n136:   <button class=\"nav-btn\" onclick=\"goSlide(1)\" aria-label=\"Back\">← Back</button>\n137:   <div class=\"letter-wrap\">\n138:     <!-- Place khushbu.jpg in the same folder -->\n139:     <img src=\"khushbu.jpg\" alt=\"\" class=\"letter-bg\" onerror=\"this.style.display='none'\">\n140:     <h2>A Letter for Khushbu Didi 💌</h2>\n141:     <p>Dear Khushbu Didi,</p>\n142:     <p>Happy Birthday to the best sister in the world! I'm so grateful to have you in my life.</p>\n143:     <p>You're more than my sister—you're my best friend, my teacher, and someone who has cared for me like a mother. I may not always have the words to express how much I respect and love you, but I hope you know this: whenever you need me, I'll always be there for you.</p>\n144:     <p>Even though I'm your little brother, you can count on me like a big brother whenever you need support. In good times or difficult ones, just reach out. If you need anything, call me—I'm only a call away.</p>\n145:     <p>I hope this year brings you as much happiness, laughter, and love as you bring to everyone around you. You deserve the very best.</p>\n146:     <p class=\"sign\">With lots of love,<br>Your small bro,<br><strong>YASH</strong> ❤️</p>\n147:   </div>\n148:   <button class=\"btn\" id=\"continue2\" onclick=\"goSlide(3)\">Play a Game! 🎈</button>\n149: </section>\n150: \n151: <!-- ═══════ SLIDE 3 ═══════ -->\n152: <section class=\"slide\" id=\"slide3\">\n153:   <button class=\"nav-btn\" onclick=\"goSlide(2)\" aria-label=\"Back\">← Back</button>\n154:   <div id=\"score-bar\">\n155:     <h2>Pop the Balloons! 🎈</h2>\n156:     <div id=\"score\">Score: 0</div>\n157:   </div>\n158:   <div id=\"game-area\"></div>\n159:   <div id=\"game-end\">\n160:     <div class=\"end-emoji\">🎉🎂🥳</div>\n161:     <h2>Amazing, Khushbu Didi!</h2>\n162:     <p class=\"end-msg\">You popped all the balloons!</p>\n163:     <p class=\"final-score\" id=\"final-score\">Score: 10 / 10</p>\n164:     <button class=\"btn\" id=\"play-again-end\" onclick=\"resetGame()\" style=\"background:linear-gradient(135deg,var(--pink),#e895b3);color:#fff\">Play Again 🔄</button>\n165:   </div>\n166:   <button class=\"btn\" id=\"play-again\" onclick=\"resetGame()\">Play Again 🔄</button>\n167: </section>\n168: \n169: <script>\n170: /* ── Sparkles ── */\n171: const cv=document.getElementById('sparkle-canvas'),ctx=cv.getContext('2d');\n172: let sparks=[];\n173: function resizeCanvas(){cv.width=innerWidth;cv.height=innerHeight}\n174: resizeCanvas();addEventListener('resize',resizeCanvas);\n175: const prefersReduced=matchMedia('(prefers-reduced-motion: reduce)').matches;\n176: function spawnSparkle(){if(prefersReduced)return;sparks.push({x:Math.random()*cv.width,y:Math.random()*cv.height,r:Math.random()*2+.5,a:Math.random(),d:Math.random()*.02+.005,f:Math.random()>.5?1:-1})}\n177: function drawSparkles(){ctx.clearRect(0,0,cv.width,cv.height);sparks.forEach((s,i)=>{s.a+=s.d*s.f;if(s.a<=0||s.a>=1)s.f*=-1;ctx.beginPath();ctx.arc(s.x,s.y,s.r,0,Math.PI*2);ctx.fillStyle=`rgba(212,168,67,${s.a*.4})`;ctx.fill()});if(sparks.length<40)spawnSparkle();requestAnimationFrame(drawSparkles)}\n178: if(!prefersReduced)drawSparkles();\n179: \n180: /* ── Music ── */\n181: const bgm=document.getElementById('bgm'),mLabel=document.getElementById('music-label'),musicButton=document.getElementById('music-ctrl');\n182: let playing=false;\n183: function setMusicState(isPlaying){playing=isPlaying;mLabel.textContent=isPlaying?'Pause music':'Play music';musicButton.setAttribute('aria-label',isPlaying?'Pause birthday music':'Play birthday music')}\n184: function toggleMusic(){if(playing){bgm.pause();setMusicState(false)}else{bgm.play().then(()=>setMusicState(true)).catch(()=>{setMusicState(false);mLabel.textContent='Tap to play'})}}\n185: bgm.addEventListener('play',()=>setMusicState(true));\n186: bgm.addEventListener('pause',()=>setMusicState(false));\n187: bgm.addEventListener('error',()=>{setMusicState(false);mLabel.textContent='Music unavailable'});\n188: // Try autoplay on load; if the browser blocks it, start on the very first user interaction.\n189: bgm.play().then(()=>setMusicState(true)).catch(()=>{\n190:   setMusicState(false);\n191:   function autoStart(){bgm.play().then(()=>setMusicState(true)).catch(()=>{});document.removeEventListener('click',autoStart);document.removeEventListener('touchstart',autoStart)}\n192:   document.addEventListener('click',autoStart,{once:false});\n193:   document.addEventListener('touchstart',autoStart,{once:false});\n194: });\n195: \n196: /* ── Slide navigation ── */\n197: function goSlide(n){document.querySelectorAll('.slide').forEach(s=>s.classList.remove('active'));document.getElementById('slide'+n).classList.add('active');scrollTo(0,0);if(n===3&&!gameRunning)startGame()}\n198: \n199: /* ── NO button runaway (fast corner cycle) ── */\n200: let cornerIdx=0,noInterval=null;\n201: const corners=[{top:'1rem',left:'1rem'},{top:'1rem',right:'1rem'},{bottom:'6rem',right:'1rem'},{bottom:'6rem',left:'1rem'}];\n202: function moveNo(){const b=document.getElementById('no-btn');b.style.position='fixed';b.style.top='auto';b.style.right='auto';b.style.bottom='auto';b.style.left='auto';Object.assign(b.style,corners[cornerIdx%corners.length]);cornerIdx++}\n203: function runAway(){if(noInterval)return;moveNo();noInterval=setInterval(moveNo,400)}\n204: \n205: /* ── YES ── */\n206: function sayYes(){document.getElementById('q-section').style.display='none';document.getElementById('result').style.display='block';launchBalloons()}\n207: \n208: /* ── Celebration balloons ── */\n209: function launchBalloons(){if(prefersReduced)return;const c=document.getElementById('balloons');c.style.display='block';c.innerHTML='';const colors=['#f8b4c8','#fcd5c0','#f0d68a','#e895b3','#a8d8ea','#c3aed6','#ffd3b6'];for(let i=0;i<18;i++){const b=document.createElement('div');b.className='balloon';b.style.left=Math.random()*90+5+'%';b.style.background=colors[i%colors.length];b.style.animationDelay=Math.random()*2+'s';b.style.animationDuration=3+Math.random()*3+'s';c.appendChild(b)}setTimeout(()=>c.style.display='none',7000)}\n210: \n211: /* ── Balloon Game ── */\n212: const MAX_POPS=10;\n213: let score=0,gameRunning=false,spawnTimer;\n214: const colors=['#f8b4c8','#fcd5c0','#f0d68a','#e895b3','#a8d8ea','#c3aed6','#ff9a9e','#96e6a1'];\n215: const faces=['🎈','🎁','⭐','🎀','💖','🌸','🎉','✨'];\n216: function startGame(){gameRunning=true;score=0;updScore();document.getElementById('game-area').style.display='';document.getElementById('score-bar').style.display='';document.getElementById('play-again').style.display='';document.getElementById('game-end').style.display='none';spawnTimer=setInterval(spawnGameBalloon,900)}\n217: function updScore(){document.getElementById('score').textContent='Score: '+score+' / '+MAX_POPS}\n218: function endGame(){clearInterval(spawnTimer);gameRunning=false;document.getElementById('game-area').innerHTML='';document.getElementById('game-area').style.display='none';document.getElementById('score-bar').style.display='none';document.getElementById('play-again').style.display='none';document.getElementById('final-score').textContent='Score: '+score+' / '+MAX_POPS;document.getElementById('game-end').style.display='flex';launchBalloons()}\n219: function spawnGameBalloon(){if(!gameRunning)return;const area=document.getElementById('game-area');if(area.children.length>12)return;const b=document.createElement('div');b.className='game-balloon';const sz=Math.random()*20+40;b.style.width=sz+'px';b.style.height=sz*1.25+'px';b.style.background=colors[Math.floor(Math.random()*colors.length)];b.style.left=Math.random()*(area.offsetWidth-sz)+'px';b.style.top=Math.random()*(area.offsetHeight-sz)+'px';b.textContent=faces[Math.floor(Math.random()*faces.length)];b.addEventListener('pointerdown',e=>{e.preventDefault();if(!gameRunning)return;b.classList.add('pop');score++;updScore();setTimeout(()=>b.remove(),300);if(score>=MAX_POPS)endGame()});area.appendChild(b);setTimeout(()=>{if(b.parentNode&&!b.classList.contains('pop'))b.remove()},3000)}\n220: function resetGame(){clearInterval(spawnTimer);document.getElementById('game-area').innerHTML='';startGame()}\n221: </script>\n222: </body>\n223: </html>\n224: "}
